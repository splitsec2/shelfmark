 # a RUN adds a layer, it does not rewrite the one underneath.
 FROM ghcr.io/astral-sh/uv:0.13.6@sha256:af22a52f5eafef3d78e551599d405c02df61919d18028f0cea8eda93bc9986d0 AS uv
 
+# --- Chrome for Testing (PINNED to 156.0.8078.80) ---
+FROM --platform=$BUILDPLATFORM python:3.14.9-slim@sha256:35caba83af2fe6da9a5d922f9b0156f21d1246a48278c58a08bd253303ba42e8 AS chrome-download
+ARG TARGETARCH
+ARG CHROME_VERSION=156.0.8078.80
+ARG CHROME_SHA256_AMD64=b711c720f774be355197f32edf37e0651418ba036d92446ee2da19ac017540a7
+ARG CHROME_SHA256_ARM64=1f496a826c9ba4d6a5f5bf2de686145fe718528c2cc3dbeb96b5893b89653724
+RUN apt-get update && apt-get install -y --no-install-recommends curl unzip ca-certificates && \
+    case "${TARGETARCH}" in \
+        amd64) platform=linux64; sha="${CHROME_SHA256_AMD64}" ;; \
+        arm64) platform=linux-arm64; sha="${CHROME_SHA256_ARM64}" ;; \
+        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
+    esac && \
+    curl -fsSLo /tmp/chrome.zip "https://storage.googleapis.com/chrome-for-testing-public/${CHROME_VERSION}/${platform}/chrome-${platform}.zip" && \
+    echo "${sha}  /tmp/chrome.zip" | sha256sum -c - && \
+    mkdir -p /out/opt && unzip -q /tmp/chrome.zip -d /tmp/chrome && \
+    mv "/tmp/chrome/chrome-${platform}" /out/opt/chrome-for-testing
+
 # Use python-slim as the base image
